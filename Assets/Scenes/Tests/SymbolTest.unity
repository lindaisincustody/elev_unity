      m_Calls: []
  m_text: '<color=#E6E8EC>Click</color>  a symbol to make it the target

    <color=#E6E8EC>Space</color> 
    random target    <color=#E6E8EC>Left / Right</color>  step

    <color=#E6E8EC>Tab</color> 
    switch grid: combined / model / $P

    <color=#E6E8EC>G</color>  toggle tracing
    guide

    <color=#E6E8EC>P</color>  rebuild templates and re-score recordings

    <color=#E6E8EC>E</color> 
    save templates for the game

    <color=#E6E8EC>R</color>  clear stats (recordings
    stay)

    every stroke is saved to SymbolRecordings/'
